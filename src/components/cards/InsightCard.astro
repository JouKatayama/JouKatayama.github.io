---
import type { CollectionEntry } from "astro:content";
import { insightVisuals, pageVisuals } from "../../data/visuals";

interface Props {
  insight: CollectionEntry<"insights">;
}
const { insight } = Astro.props;
const categoryLabels = {
  remind: "Re:Mind",
  "ai-career": "AIとキャリア",
  organization: "組織開発",
  "people-analytics": "People Analytics",
  youth: "若者・学生支援",
  wellbeing: "well-being",
  report: "活動レポート",
};
const date = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(insight.data.publishedAt);
const readingTime = Math.max(3, Math.round((insight.body?.length ?? 0) / 700 || 3));
const visual = insightVisuals[insight.id] || pageVisuals.insights;
---

<article class="insight-card" data-reveal>
  <figure class="insight-card__visual">
    <img src={visual.src} alt={visual.alt} width="720" height="480" loading="lazy" style={`object-position: ${visual.position || "center"}`} />
  </figure>
  <div class="insight-card__body">
    <p class="insight-card__category">{categoryLabels[insight.data.category]}</p>
    <h3><a href={`/insights/${insight.id}/`}>{insight.data.title}</a></h3>
    <p>{insight.data.description}</p>
    <div class="insight-card__meta">
      <time datetime={insight.data.publishedAt.toISOString()}>{date}</time>
      <span>{readingTime} min read</span>
    </div>
    <a class="card-link" href={`/insights/${insight.id}/`}>記事を読む <span>↗</span></a>
  </div>
</article>
