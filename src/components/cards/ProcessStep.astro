---
interface Props {
  number: string;
  name: string;
  label: string;
  text: string;
}
const { number, name, label, text } = Astro.props;
---

<article class="process-step" data-reveal>
  <div class="process-step__top">
    <span>{number}</span>
    <i aria-hidden="true"></i>
  </div>
  <p class="process-step__name">{name}</p>
  <h3>{label}</h3>
  <p>{text}</p>
</article>
