---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";
import { pageVisuals, projectVisuals } from "../../data/visuals";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const categoryLabels = {
  remind: "Re:Mind",
  project: "実践プロジェクト",
  community: "コミュニティ",
  research: "研究・社会実装",
};
const date = project.data.startAt
  ? new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "short" }).format(project.data.startAt)
  : project.data.status === "completed"
    ? new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "short" }).format(project.data.publishedAt)
    : project.data.status === "ongoing"
      ? "継続実施"
      : project.data.status === "planned"
        ? "準備中"
        : "募集ページで確認";
const visual = projectVisuals[project.id] || pageVisuals.projects;
---

<article class="project-card" data-reveal>
  <figure class="project-card__visual">
    <img src={visual.src} alt={visual.alt} width="720" height="480" loading="lazy" style={`object-position: ${visual.position || "center"}; object-fit: ${visual.fit || "cover"}`} />
    <figcaption>{categoryLabels[project.data.category]}</figcaption>
  </figure>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{categoryLabels[project.data.category]}</span>
      <StatusBadge status={project.data.status} />
    </div>
    <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
    <dl>
      <div><dt>対象</dt><dd>{project.data.audience.join("・")}</dd></div>
      <div><dt>実施</dt><dd>{date}</dd></div>
    </dl>
    <a class="card-link" href={`/projects/${project.id}/`}>プロジェクトを見る <span>↗</span></a>
  </div>
</article>
