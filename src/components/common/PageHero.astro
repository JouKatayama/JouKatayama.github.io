---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero__inner" data-reveal>
    <p class="eyebrow"><span>{eyebrow}</span></p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>
