---
import SectionIntro from "../common/SectionIntro.astro";
import ActivityCard from "../cards/ActivityCard.astro";

const activities = [
  ["01", "第三の場所をひらく", "会社や学校から少し離れ、利害関係に縛られずに相談・交流できる場を育てます。", "/activities/#third-place"],
  ["02", "壁打ち・メンタリング", "先輩の経験と異分野の知見を持ち寄り、やりたいことや次の一歩を一緒に言葉にします。", "/activities/#mentoring"],
  ["03", "越境して学び、試す", "最新知見に触れ、実在する課題や小さなプロジェクトで未経験の領域に挑戦します。", "/activities/#cross-boundary"],
  ["04", "経験を次へつなぐ", "対話・実践・成果を振り返って可視化し、次の学びや役割、共創の機会へ接続します。", "/activities/#growth-cycle"],
];
---

<section class="section activities">
  <div class="container">
    <div class="activities__head">
      <SectionIntro eyebrow="03 / CURRENT FOCUS" title="まず、相談できる。次に、越境して試せる。" />
      <p data-reveal>
        直近の事業では、第三の場所づくり、壁打ち、越境学習、小さな実践を中心に据えます。教える側と学ぶ側を固定せず、互いの経験を社会の力に変えていきます。
      </p>
    </div>
    <figure class="activities-photo" data-reveal>
      <img
        src="/images/project-workshop-v2.webp"
        width="1536"
        height="1024"
        alt="若者たちがプロジェクトのアイデアを形にするワークショップのイメージ"
        loading="lazy"
      />
      <figcaption>
        <span>LEARN BY DOING</span>
        <strong>知見を持ち寄り、未経験への足場をつくる。</strong>
      </figcaption>
    </figure>
    <div class="activities-grid">
      {activities.map(([number, title, text, href]) => (
        <ActivityCard number={number} title={title} text={text} href={href} />
      ))}
    </div>
  </div>
</section>
