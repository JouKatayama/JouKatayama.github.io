---
import SectionIntro from "../common/SectionIntro.astro";
import ActivityCard from "../cards/ActivityCard.astro";

const activities = [
  ["01", "就活・キャリア支援", "新卒就活、職業開発、就労支援を通じて、働き方と自己実現をともに考えます。", "/activities/#career-support"],
  ["02", "実践型インターン", "新規事業、人事・広報、マーケティング・営業を、企画から実行まで経験します。", "/activities/#internship"],
  ["03", "AI / DX実践", "企業案件と新規開発を通じて、AIを実務で使い、つくる力を身につけます。", "/activities/#ai-dx"],
  ["04", "専門家と多世代の協働", "キャリア支援の専門家と、多様な職種・世代のメンバーが経験を持ち寄ります。", "/activities/#community"],
];
---

<section class="section activities">
  <div class="container">
    <SectionIntro eyebrow="04 / ACTIVITIES" title="活動の4つの柱" />
    <div class="activities-grid">
      {activities.map(([number, title, text, href]) => (
        <ActivityCard number={number} title={title} text={text} href={href} />
      ))}
    </div>
  </div>
</section>
