---
const steps = [
  ["01", "問いに触れる"],
  ["02", "視野が広がる"],
  ["03", "当事者性が育つ"],
  ["04", "小さく実践する"],
  ["05", "成果を完了する"],
  ["06", "次の機会へ進む"],
];
---

<section class="impact">
  <div class="impact__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="impact__head" data-reveal>
      <p>IMPACT</p>
      <h2>個人の可能性を拡張し、<br />社会全体の適応力を高める</h2>
    </div>
    <div class="impact__process" data-reveal>
      {steps.map(([number, label]) => (
        <div><span>{number}</span><strong>{label}</strong><i aria-hidden="true">→</i></div>
      ))}
    </div>
    <p class="impact__result" data-reveal><span>可能性の</span>最大化</p>
  </div>
</section>
