---
const steps = [
  ["01", "人的資本を育てる"],
  ["02", "イノベーションを促す"],
  ["03", "産業の適応力を高める"],
  ["04", "地域・社会課題に挑む"],
  ["05", "より良い未来へつなぐ"],
];
---

<section class="impact">
  <div class="impact__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="impact__head" data-reveal>
      <p>FUTURE IMPACT</p>
      <h2>一人の可能性がひらくほど、<br />社会全体の未来も加速する。</h2>
    </div>
    <div class="impact__process" data-reveal>
      {steps.map(([number, label]) => (
        <div><span>{number}</span><strong>{label}</strong><i aria-hidden="true">→</i></div>
      ))}
    </div>
    <p class="impact__result" data-reveal><span>CAREER GROWTH</span>SPIRAL</p>
  </div>
</section>
