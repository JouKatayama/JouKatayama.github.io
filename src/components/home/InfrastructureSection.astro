---
import SectionIntro from "../common/SectionIntro.astro";
import ValueCard from "../cards/ValueCard.astro";
import EcosystemDiagram from "./EcosystemDiagram.astro";

const values = [
  ["01", "情報・知見", "AI、技術、仕事、社会の変化を持ち寄る"],
  ["02", "壁打ち・相談", "所属を越えたメンターと問いを深める"],
  ["03", "交流・つながり", "世代、職種、地域を越えて出会う"],
  ["04", "越境プロジェクト", "実在する課題にチームで小さく挑戦する"],
  ["05", "記録・データ", "学びと成果を可視化し、次に生かす"],
  ["06", "共創・次の機会", "副業、転職、研究、起業、社会実装へつなぐ"],
];
---

<section class="section infrastructure">
  <div class="container">
    <div class="infrastructure__head">
      <SectionIntro
        eyebrow="02 / OUR FOUNDATION"
        title="多様な環境の「知・経験・価値観」が交わるハブへ。"
      />
      <p data-reveal>
        企業、大学・研究機関、行政、教育機関、NPO、スタートアップ、個人の専門家。異なる強みを持つ人たちを、特定の組織に閉じないキャリアの外部インフラでつなぎます。
      </p>
    </div>
    <div class="infrastructure__layout">
      <div class="value-grid">
        {values.map(([number, title, text]) => <ValueCard number={number} title={title} text={text} />)}
      </div>
      <EcosystemDiagram />
    </div>
  </div>
</section>
