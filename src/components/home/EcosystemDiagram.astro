---
const nodes = [
  "企業",
  "大学・研究機関",
  "行政・自治体",
  "NPO・財団",
  "スタートアップ",
  "教育機関",
  "個人の専門家",
  "学生・社会人",
  "メンター・支援者",
];
---

<div class="ecosystem" aria-label="企業、大学、行政、NPOなどをつなぐキャリアキャンパスの関係図" data-reveal>
  <div class="ecosystem__rings" aria-hidden="true"></div>
  <div class="ecosystem__core">
    <small>EXTERNAL INFRASTRUCTURE</small>
    <strong>CAREER<br />CAMPUS</strong>
    <span>外部インフラ／サードプレイス</span>
  </div>
  {nodes.map((node, index) => (
    <span class={`ecosystem__node ecosystem__node--${index + 1}`}>{node}</span>
  ))}
</div>
