---
import SectionIntro from "../common/SectionIntro.astro";
import ProcessStep from "../cards/ProcessStep.astro";

const steps = [
  ["01", "CONNECT", "つながる", "所属・世代・職種を越えて、多様な人と出会う。"],
  ["02", "LEARN", "学ぶ・気づく", "新しい知見と対話から、視野と問いを更新する。"],
  ["03", "PRACTICE", "実践する", "未経験の領域や社会の課題を、小さく試してみる。"],
  ["04", "COMPLETE", "成果を出す", "学びを成果物や貢献として形にし、振り返る。"],
  ["05", "CONTINUE", "次の機会へ", "得た経験を、次の学び・役割・キャリアへつなぐ。"],
];
---

<section class="section remind" id="remind">
  <div class="container">
    <div class="remind__head">
      <SectionIntro eyebrow="05 / VALUE CYCLE" title="経験が、次の機会を生む5つの循環。" />
      <p data-reveal>
        つながる、学ぶ、試す、成果を出す、次へ進む。Re:Mindは、この循環の中で自分と環境の前提を問い直し、もう一度選び動ける状態を取り戻すための考え方です。
      </p>
    </div>
    <div class="process-grid">
      {steps.map(([number, name, label, text]) => (
        <ProcessStep number={number} name={name} label={label} text={text} />
      ))}
    </div>
  </div>
</section>
