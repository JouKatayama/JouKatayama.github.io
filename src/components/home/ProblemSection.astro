---
import SectionIntro from "../common/SectionIntro.astro";
import PersonaCard from "../cards/PersonaCard.astro";

const personas = [
  {
    number: "01",
    label: "INFORMATION GAP",
    title: "見える情報が、所属先の内側に偏る",
    text: "新しい仕事や技術、市場の変化に触れる機会は、学校・会社・地域によって大きく異なります。",
  },
  {
    number: "02",
    label: "EXPERIENCE GAP",
    title: "挑戦したくても、試せる機会がない",
    text: "知識を得ても、実在する課題で試す場がなければ経験にはなりません。小さく挑戦できる足場が必要です。",
  },
  {
    number: "03",
    label: "RELATIONSHIP GAP",
    title: "相談相手やロールモデルが限られる",
    text: "評価や人間関係が固定されると、違う価値観から助言を得にくく、市場や社会との距離も広がっていきます。",
  },
];
---

<section class="section problem" id="problem">
  <div class="container">
    <SectionIntro eyebrow="01 / WHY WE EXIST" title="可能性の差は、本人より先に環境から生まれる。" />
    <p class="problem__statement" data-reveal>
      だから、所属の外にも<br /><span>学びと挑戦の入口</span>をつくる。
    </p>
    <p class="problem__lead" data-reveal>
      会社や学校を否定するのではなく、その外にも接点を持つ。異なる業界・世代・専門性に出会うことで、自分と環境を複数の視点から見直せる状態をつくります。
    </p>
    <div class="persona-grid">
      {personas.map((persona) => <PersonaCard {...persona} />)}
    </div>
    <div class="issue-structure" data-reveal>
      <p>越えたい「環境格差」</p>
      <div>
        <span>最新情報へのアクセス</span>
        <span>実践・挑戦の機会</span>
        <span>メンターとの出会い</span>
        <span>組織外からの評価</span>
        <span>市場・社会との接点</span>
      </div>
    </div>
    <div class="problem-story" data-reveal>
      <figure>
        <img
          src="/images/career-dialogue-v2.webp"
          width="1122"
          height="1402"
          alt="キャリアについて一対一で対話するイメージ"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="eyebrow"><span>OUR APPROACH</span></p>
        <h3>利害関係から少し離れて、<br />安心して壁打ちできる。</h3>
        <p>
          先輩の経験と、後輩や異分野の新しい知見を持ち寄る。教える側と学ぶ側を固定せず、対話の中で互いの視野を広げる。その関係性を、キャリアの挑戦を支える土台にします。
        </p>
        <a class="text-link" href="/about/">活動の背景と理念を読む <span>→</span></a>
      </div>
    </div>
  </div>
</section>
