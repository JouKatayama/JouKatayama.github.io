---
import SectionIntro from "../common/SectionIntro.astro";
import PersonaCard from "../cards/PersonaCard.astro";

const personas = [
  {
    number: "01",
    label: "FIND A COMPASS",
    title: "選びたいのに、自分の軸が見つからない",
    text: "周囲の正解や求人情報はたくさんある。でも、自分が何を大切にしたいのかを言葉にする機会は、意外と少ない。",
  },
  {
    number: "02",
    label: "TAKE A STEP",
    title: "変わりたいのに、最初の一歩がわからない",
    text: "大きな決断には不安がある。だからこそ、仕事を辞める前に、小さく試して確かめられる場所が必要です。",
  },
  {
    number: "03",
    label: "TURN INTO PRACTICE",
    title: "学んでも、実践につながらない",
    text: "知識や資格だけでは、自信になりにくい。誰かの課題に向き合い、最後まで形にする経験が、次の選択肢を増やします。",
  },
];
---

<section class="section problem" id="problem">
  <div class="container">
    <SectionIntro eyebrow="01 / WHY WE EXIST" title="選べないのは、意志が弱いからではない。" />
    <p class="problem__statement" data-reveal>
      可能性が、<br /><span>所属と経験の内側</span>だけで決まってしまう。
    </p>
    <p class="problem__lead" data-reveal>
      学校や会社だけでは出会えない人・仕事・価値観があります。環境の外へ少しだけひらくことで、「自分には無理」だった未来が、試せる選択肢へ変わります。
    </p>
    <div class="persona-grid">
      {personas.map((persona) => <PersonaCard {...persona} />)}
    </div>
    <div class="issue-structure" data-reveal>
      <p>共通する構造</p>
      <div>
        <span>自分を知る対話</span>
        <span>多様な人との出会い</span>
        <span>小さく試せる仕事</span>
        <span>経験を言葉にする伴走</span>
      </div>
    </div>
    <div class="problem-story" data-reveal>
      <figure>
        <img
          src="/images/career-dialogue-v2.webp"
          width="1122"
          height="1402"
          alt="キャリアについて一対一で対話するイメージ"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="eyebrow"><span>OUR APPROACH</span></p>
        <h3>答えを渡すのではなく、<br />一緒に問いを育てる。</h3>
        <p>
          私たちが大切にするのは、本人の代わりに正解を決めることではありません。今感じている違和感や関心を言葉にし、現実の仕事やプロジェクトで確かめ、経験から次の問いを見つける。その循環を支えます。
        </p>
        <a class="text-link" href="/about/">活動の背景と理念を読む <span>→</span></a>
      </div>
    </div>
  </div>
</section>
