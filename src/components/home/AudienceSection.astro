---
import SectionIntro from "../common/SectionIntro.astro";
import AudienceCard from "../cards/AudienceCard.astro";

const individualUrl = import.meta.env.PUBLIC_INDIVIDUAL_FORM_URL || "/contact/";
const partnerUrl = import.meta.env.PUBLIC_PARTNER_FORM_URL || "/contact/";
const supporterUrl = import.meta.env.PUBLIC_SUPPORTER_FORM_URL || "/contact/";
const audiences = [
  ["01", "INDIVIDUAL", "個人として", "就活・キャリア相談、新規事業、マーケティング、AI/DXなど、自分の現在地に合う実践へ参加できます。", "個人として参加する", individualUrl],
  ["02", "ORGANIZATION", "企業・大学・自治体として", "若者の実践機会と組織・地域の課題をつなぎ、キャリア教育や就労支援を共同で設計できます。", "連携について相談する", partnerUrl],
  ["03", "SUPPORTER", "メンター・支援者として", "キャリア支援や実務の専門性、プロジェクト提供、寄付を通じて、挑戦の循環を支えられます。", "支援方法を見る", supporterUrl],
];
---

<section class="section audience">
  <div class="container">
    <SectionIntro eyebrow="06 / JOIN US" title="あなたの関わり方" />
    <div class="audience-grid">
      {audiences.map(([number, label, title, text, cta, href]) => (
        <AudienceCard number={number} label={label} title={title} text={text} cta={cta} href={href} />
      ))}
    </div>
  </div>
</section>
