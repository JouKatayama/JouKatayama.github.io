---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import { organization } from "../../data/organization";
import { activityVisuals, pageVisuals } from "../../data/visuals";

const activities = [
  {
    id: "career-support",
    number: "01",
    title: "就活・キャリア支援",
    lead: "選考対策だけでなく、働き方と自己実現を一緒に考える。",
    text: "新卒の就職活動から、働くことに悩みを抱える人の就労支援まで。国家資格キャリアコンサルタントを含むメンバーが、対話を通じて現在地と次の一歩を整理します。",
    points: ["新卒就活支援", "キャリア相談・職業開発", "就労に向けた伴走支援"],
  },
  {
    id: "internship",
    number: "02",
    title: "実践型インターン",
    lead: "事業を考え、つくり、届けるところまで。",
    text: "新規事業、人事・広報、マーケティング・営業など、実務に近いテーマに長期で取り組みます。過去の外部紹介では、英語学習サービスの企画から販売までを学生が担う実践も紹介されました。",
    points: ["新規事業の企画・検証", "採用・広報・デザイン", "マーケティング・営業"],
  },
  {
    id: "ai-dx",
    number: "03",
    title: "AI / DX実践",
    lead: "学習だけでなく、企業案件と新規開発で使う。",
    text: "AIの最新動向を学びながら、実際の顧客案件やサービス開発に挑戦します。公開中の募集では、AIによるデータベース登録、GPTsを使ったコピー生成、AI Tuber、災害支援マップなどの開発例が示されています。",
    points: ["ChatGPT・プロンプト設計", "Python・ReactによるAIシステム開発", "企業のDX支援"],
  },
  {
    id: "community",
    number: "04",
    title: "専門家と多世代の協働",
    lead: "一つの所属や職種に閉じない視点を持ち寄る。",
    text: "学生、若手社会人、中堅社会人、キャリア支援の専門家が参加。営業、人事、エンジニア、事務、専門職など、多様な経験を相談・企画・実践へつなげます。",
    points: ["国家資格キャリアコンサルタント", "学生から中堅社会人まで", "多様な職種・専門性"],
  },
];
---

<SiteLayout
  title="活動｜NPO法人キャリアキャンパス"
  description="就活・キャリア支援、実践型インターン、AI/DX、専門家と多世代の協働を通じて、キャリア教育を実践します。"
>
  <PageHero
    eyebrow="ACTIVITIES"
    title="相談から、実際に仕事をつくる経験まで。"
    lead="就活・就労支援と、企業や社会の課題に挑む実践機会をつなぎ、自分の能力を誰かのために使える状態を育てます。"
    visual={pageVisuals.activities}
  />
  {activities.map((activity, index) => (
    <section class:list={["content-section", { "content-section--surface": index % 2 === 1 }]} id={activity.id}>
      <div class="container activity-detail">
        <div class="content-copy" data-reveal>
          <p class="eyebrow"><span>{activity.number} / ACTIVITY</span></p>
          <h2>{activity.title}</h2>
        </div>
        <figure class="activity-detail__visual" data-reveal>
          <img
            src={activityVisuals[activity.id].src}
            alt={activityVisuals[activity.id].alt}
            width="1536"
            height="1024"
            loading="lazy"
            style={`object-position: ${activityVisuals[activity.id].position || "center"}`}
          />
        </figure>
        <div class="content-copy" data-reveal>
          <h3>{activity.lead}</h3>
          <p>{activity.text}</p>
          <ul>{activity.points.map((point) => <li>{point}</li>)}</ul>
        </div>
      </div>
    </section>
  ))}
  <section class="career-cta">
    <div class="container career-cta__inner" data-reveal>
      <div><p class="eyebrow"><span>CURRENT OPPORTUNITIES</span></p><h2>現在の募集を確認する</h2><p>職種、対象、勤務条件は募集ページの最新情報をご確認ください。</p></div>
      <div class="career-cta__actions">
        <a class="button" href={organization.careersUrl} target="_blank" rel="noreferrer">募集一覧を見る <span>↗</span></a>
        <a class="button button--ghost" href={organization.aiDxUrl} target="_blank" rel="noreferrer">AI/DX募集を見る <span>↗</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
