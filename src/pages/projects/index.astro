---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<SiteLayout
  title="プロジェクト｜NPO法人キャリアキャンパス"
  description="キャリアキャンパスが行うRe:Mind、越境実践、コミュニティ、研究のプロジェクトをご紹介します。"
>
  <PageHero
    eyebrow="PROJECTS"
    title="実在する問いに、小さく挑戦する。"
    lead="所属や世代を越えたチームで課題を定義し、検証し、他者に届く成果物まで完成させます。"
  />
  <section class="listing-section">
    <div class="container">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</SiteLayout>
