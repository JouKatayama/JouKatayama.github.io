---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";
import { pageVisuals } from "../../data/visuals";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<SiteLayout
  title="プロジェクト｜NPO法人キャリアキャンパス"
  description="キャリアキャンパスが行うキャリア支援、新規事業、マーケティング、AI/DXの実践をご紹介します。"
>
  <PageHero
    eyebrow="PROJECTS"
    title="現在の募集と、将来につながる実践。"
    lead="第三の場所と越境学習を基盤にしながら、就活支援、新規事業、AI/DXへ段階的に広げます。ここでは外部で公開中の募集・活動情報をご案内します。"
    visual={pageVisuals.projects}
  />
  <section class="listing-section">
    <div class="container">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</SiteLayout>
