---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import ProjectCard from "../../components/cards/ProjectCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<SiteLayout
  title="プロジェクト｜NPO法人キャリアキャンパス"
  description="キャリアキャンパスが行うキャリア支援、新規事業、マーケティング、AI/DXの実践をご紹介します。"
>
  <PageHero
    eyebrow="PROJECTS"
    title="現在の活動と、公開中の募集。"
    lead="キャリア支援から、新規事業・マーケティング・AI/DXの実践まで。募集条件はリンク先の最新情報をご確認ください。"
  />
  <section class="listing-section">
    <div class="container">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</SiteLayout>
