---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import { organization } from "../../data/organization";

const formLinks = [
  { label: "個人としての参加について", href: import.meta.env.PUBLIC_INDIVIDUAL_FORM_URL, external: false },
  { label: "企業・大学・自治体との連携について", href: import.meta.env.PUBLIC_PARTNER_FORM_URL, external: false },
  { label: "メンター・寄付・協賛について", href: import.meta.env.PUBLIC_SUPPORTER_FORM_URL, external: false },
].filter((link) => Boolean(link.href));
const links = [
  ...formLinks,
  { label: `電話する（${organization.telephone}）`, href: organization.telephoneHref, external: false },
  { label: "現在の募集を見る", href: organization.careersUrl, external: true },
  { label: "Syncableで活動を支援する", href: organization.supportUrl, external: true },
];
---

<SiteLayout title="お問い合わせ｜NPO法人キャリアキャンパス" description="活動への参加、組織連携、メンター・支援に関するお問い合わせ窓口と法人連絡先です。">
  <PageHero eyebrow="CONTACT" title="まずは、問いや課題を聞かせてください。" lead="参加・連携・支援のご相談を受け付けています。募集条件は各募集ページの最新情報をご確認ください。" />
  <section class="content-section">
    <div class="container contact-panel" id="contact-notice">
      <div data-reveal>
        <h2>お問い合わせ窓口</h2>
        <p>{formLinks.length > 0 ? "ご相談内容に近いフォームまたは公開窓口をお選びください。" : "現在、専用フォームを準備中です。お電話または公開窓口からご連絡ください。"}</p>
        <address>〒{organization.postalCode}<br />{organization.address}<br /><a href={organization.telephoneHref}>{organization.telephone}</a></address>
        <a class="text-link text-link--light" href={organization.mapUrl} target="_blank" rel="noreferrer">地図で確認する <span>↗</span></a>
      </div>
      <div class="contact-panel__links" data-reveal>
        {links.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{link.label}<span>{link.external ? "↗" : "→"}</span></a>)}
      </div>
    </div>
  </section>
</SiteLayout>
