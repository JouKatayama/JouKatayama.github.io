---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import { organization } from "../../data/organization";
import { pageVisuals } from "../../data/visuals";

const title = "私たちについて｜NPO法人キャリアキャンパス";
const description = "キャリアキャンパスが直近に進める第三の場所・越境学習の方針と、Mission・Vision・Value、設立の背景をご紹介します。";
---

<SiteLayout title={title} description={description}>
  <PageHero
    eyebrow="ABOUT US"
    title="所属を越えたつながりから、可能性をひらく。"
    lead="キャリアキャンパスは、会社でも学校でもない第三の場所を基盤に、対話・越境学習・実践をつなぐNPOです。"
    visual={pageVisuals.about}
  />

  <section class="content-section current-direction">
    <div class="container content-grid">
      <div class="content-copy" data-reveal>
        <p class="eyebrow"><span>CURRENT DIRECTION</span></p>
        <h2>直近の中心は、環境格差を越える外部インフラづくり。</h2>
        <p>所属する会社・学校・地域によって、得られる情報、出会える人、挑戦できる機会は異なります。だから私たちは、所属先の外にも学びと実践の入口をつくります。</p>
      </div>
      <div>
        <article class="info-card" data-reveal><span>FOUNDATION</span><h3>第三の場所と互助の輪</h3><p>利害関係に縛られず、安心して相談し、異なる経験に出会える関係を育てます。</p></article>
        <article class="info-card" data-reveal><span>ACTION</span><h3>教え合いと越境実践</h3><p>最新知見に触れ、未経験の課題を小さく試し、経験を次の機会へつなげます。</p></article>
        <article class="info-card info-card--future" data-reveal><span>TO-BE</span><h3>多様なキャリアと共創エコシステム</h3><p>就活支援、インターン、AI/DX、新規事業を段階的に広げ、地域や組織を越える循環を目指します。</p></article>
      </div>
    </div>
  </section>

  <section class="content-section content-section--surface">
    <div class="container">
      <div class="content-copy philosophy-head" data-reveal>
        <p class="eyebrow"><span>MISSION / VISION / VALUE</span></p>
        <h2>社会を変える起点は、一人ひとりのキャリアにある。</h2>
      </div>
      <div class="philosophy-grid">
        <article data-reveal><span>MISSION</span><h3>{organization.mission}</h3><p>仕事を選ぶ技術だけでなく、自分らしい生き方と働き方を考え、実践できる土台をつくります。</p></article>
        <article data-reveal><span>VISION</span><h3>{organization.vision}</h3><p>年齢や所属にかかわらず、一人ひとりが能力を生かし、よりよく働ける社会を目指します。</p></article>
        <article data-reveal><span>VALUE</span><h3>{organization.value}</h3><p>自分の個性や専門性を誰かのために使い、支援が次の支援につながる循環を育てます。</p></article>
      </div>
    </div>
  </section>

  <section class="content-section" id="remind">
    <div class="container content-grid">
      <div class="content-copy" data-reveal>
        <p class="eyebrow"><span>Re:Mind</span></p>
        <h2>リスキリングの前に、Re:Mind。</h2>
        <p>Re:Mindは、公式Missionを日々の行動に結びつける、このWebサイトのアクションコンセプトです。</p>
      </div>
      <div>
        <article class="info-card" data-reveal><span>01</span><h3>現実を知る</h3><p>思い込みではなく、対話と事実から現在地を捉える。</p></article>
        <article class="info-card" data-reveal><span>02</span><h3>選び直す</h3><p>就職、転職、学び、挑戦の理由を自分の言葉で決める。</p></article>
        <article class="info-card" data-reveal><span>03</span><h3>実践する</h3><p>就活支援や新規事業、AI/DXの現場で、小さく試して学びを残す。</p></article>
      </div>
    </div>
  </section>

  <section class="content-section content-section--surface">
    <div class="container content-grid">
      <div class="content-copy" data-reveal>
        <p class="eyebrow"><span>HOW WE BEGAN</span></p>
        <h2>一人への就活支援から始まった、助け合いの連鎖。</h2>
      </div>
      <div class="content-copy" data-reveal>
        <p>代表理事の髙橋千春が大学生の就職活動を支援し、その学生が後輩を支えたことが活動の原点です。</p>
        <p>だから私たちは、相談に答えるだけでは終わりません。キャリア支援の専門家、多様な職種の実務家、学生や社会人がつながり、学んだ人が次の誰かに力を返せる場を育てます。</p>
        <a class="text-link" href="/organization/">法人情報と体制を見る <span>→</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
