---
import SiteLayout from "./SiteLayout.astro";
import type { SiteVisual } from "../data/visuals";

interface Props {
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  visual: SiteVisual;
}
const {
  title,
  description,
  category,
  publishedAt,
  updatedAt,
  author = "キャリアキャンパス",
  visual,
} = Astro.props;
const date = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(publishedAt);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt || publishedAt).toISOString(),
  author: { "@type": author === "キャリアキャンパス" ? "Organization" : "Person", name: author },
  publisher: { "@type": "Organization", name: "NPO法人キャリアキャンパス" },
  inLanguage: "ja",
  mainEntityOfPage: Astro.url.href,
  image: new URL(visual.src, Astro.site).href,
};
---

<SiteLayout title={`${title}｜NPO法人キャリアキャンパス`} description={description} image={visual.src} type="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="article">
    <header class="article__header" data-reveal>
      <p class="eyebrow"><span>{category}</span></p>
      <h1>{title}</h1>
      <p class="article__lead">{description}</p>
      <div class="article__meta">
        <time datetime={publishedAt.toISOString()}>{date}</time>
        <span>{author}</span>
      </div>
    </header>
    <figure class="article__visual" data-reveal>
      <img
        src={visual.src}
        alt={visual.alt}
        width="1536"
        height="1024"
        loading="eager"
        style={`object-position: ${visual.position || "center"}; object-fit: ${visual.fit || "cover"}`}
      />
      <figcaption>{visual.caption}</figcaption>
    </figure>
    <div class="article__body">
      <slot />
    </div>
  </article>
</SiteLayout>
